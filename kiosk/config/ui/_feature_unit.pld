config:
  format_version: 1

compilations:
  feature_unit_compilation:
    name: feature unit view
    unit_type: feature
    record_type: unit
    groups:
      group_1:
        type: "stacked"
        parts:
          feature_unit.sheet:
            text: '#(unit/term_for_unit) #(unit/arch_context)'
            position: 1
          feature_unit_details.sheet:
            text: ''
            position: 2
          feature_unit_locus.sheet:
            text: ''
            position: 3
          feature_unit_narrative.list:
            text: 'narratives'
            position: 4
      group_2:
        type: "accordion"
        parts:
          unit_files.list:
            text: 'photos & files'
            position: 1
          unit_cm.list:
            text: '#(/$/glossary/collected_material:2)'
            position: 3

feature_unit.sheet:
  record_type: unit
  view_type: sheet  # (can be list, sheet or file_list or harris_matrix)
  fields_selection: dsd
  dsd_view: unit.sheet.view
  layout_settings:
    orchestration_strategy: columns  # (the default for the sheet scenario)
    default_element_visibility: "."
    order:
      - qfsite
      - id_site
      - arch_context
      - legacy_unit_id
      - name
      - line_identifiers
      - unit_creation_date
      - id_excavator
      - excavator_full_name
      - type
      - method
      - coordinates
      - purpose
  ui_elements:
    qfsite:
      element_type:
        name: "TextField"
        text: "site"
        value: "#(site/arch_context)"
        is_identifier: true
        links_to: site
    term_for_locus:
      element_type:
        visible: false
    term_for_unit:
      element_type:
        visible: false
    arch_context:
      element_type:
        is_identifier: false
    coordinates:
      element_type:
        multiline: True
      layout:
        min_width: 3
    line_identifiers:
      element_type:
        name: "line"
        transparent: true
      layout:
        min_width: max
    line_2:
      element_type:
        name: "line"
        transparent: true
      layout:
        min_width: max

feature_unit_details.sheet:
  record_type: feature_unit
  view_type: sheet  # (can be list, sheet or file_list or harris_matrix)
  fields_selection: dsd
#  dsd_view: unit.sheet.view
  layout_settings:
    orchestration_strategy: columns  # (the default for the sheet scenario)
    default_element_visibility: "."
    order:
      - feature_type
      - revisit
      - materials
      - line_1
      - width
      - length
      - height
      - elevation
      - line_2
      - created
      - modified
      - modified_by
  ui_elements:
    materials:
      element_type:
        name: "TextField"
        multiline: true
    line_1:
      element_type:
        name: "line"
        transparent: true
      layout:
        min_width: max
    line_2:
      element_type:
        name: "line"
        transparent: true
      layout:
        min_width: max

