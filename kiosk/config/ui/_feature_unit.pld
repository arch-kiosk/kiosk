feature_unit_locus.sheet:
  record_type: locus
  view_type: sheet  # (can be list, sheet or file_list or harris_matrix)
  fields_selection: dsd
  dsd_view: locus.sheet.view
  layout_settings:
    default_element_visibility: "."
    orchestration_strategy: columns  # (the default for the sheet scenario)
    order:
      - description
      - formation_process
      - colour
      - interpretation
      - line_3
      - width
      - length
      - depth
      - volume
      - line_elevation
      - elevation_opening_nw
      - elevation_opening_ne
      - elevation_opening_ct
      - elevation_opening_se
      - elevation_opening_sw
      - opening_elevations
      - line_4
      - elevation_closing_nw
      - elevation_closing_ne
      - elevation_closing_ct
      - elevation_closing_se
      - elevation_closing_sw
      - closing_elevations
  ui_elements:
    qfunit:
      element_type:
        name: "TextField"
        text: "#(unit/term_for_unit)"
        value: "#(unit/arch_context)"
        is_identifier: true
        links_to: unit
    qfsite:
      element_type:
        name: "TextField"
        text: "site"
        value: "#(site/arch_context)"
        is_identifier: true
        links_to: site
    arch_context:
      element_type:
        text: "#(unit/term_for_locus)"
#    type:
#      element_type:
#        text: "#(unit/term_for_locus) type"

    line_1:
      element_type:
        visible: True
        name: "line"
        transparent: true
      layout:
        min_width: "max"
    line_2:
      layout:
        min_width: "max"
      element_type:
        name: "line"
        visible: True
        transparent: true
    line_3:
      layout:
        min_width: "max"
      element_type:
        name: "line"
        visible: True
        transparent: true
    line_4:
      layout:
        min_width: "max"
      element_type:
        name: "line"
        visible: True
        transparent: true
    line_5:
      layout:
        min_width: "max"
      element_type:
        name: "line"
        visible: True
        transparent: true
    line_elevation:
      layout:
        min_width: "max"
      element_type:
        name: "line"
        visible: True
        transparent: true

feature_unit_narrative.list:
  record_type: unit_narrative
  view_type: list  # (can be list, sheet or file_list or harris_matrix)
  max_height: 20em
  max_height_expandable: true
  fields_selection: dsd
  layout_settings:
    type: list
    orchestration_strategy: table  # (the default for the sheet scenario)
    order_records_by: [">date", "id_excavator"]
    allow_ordering_by: ["date", "id_excavator"]
    order: [date, id_excavator, narrative]
  ui_elements:
    date:
      layout:
        min_width: 15%
    id_excavator:
      layout:
        min_width: 20%
    narrative:
      layout:
        min_width: 70%
        max_height: max

unit_files.list:
  record_type: dayplan
  view_type: list  # (can be list, sheet or file_list or harris_matrix)
  max_height: auto
  fields_selection: dsd
  layout_settings:
    type: list
    orchestration_strategy: gallery
    order_records_by: [">modified", "file_datetime"]
    allow_ordering_by: ["modified", "modified_by", "file_datetime"]
    order: [uid_image, modified, modified_by, file_datetime]

  ui_elements:
    "file_datetime":
      element_type:
        name: "datetimefield"
        text: "file date time"
        value: "#(dayplan/uid_image)"
        lookup:
          lookup_type: "file_attribute"
          attribute_name: "file_datetime"
#
#
#
unit_cm.list:
  record_type: collected_material
  view_type: list
  max_height: 20em
  fields_selection: dsd
  layout_settings:
    type: list
    orchestration_strategy: table
    order_records_by: [">arch_context"]
    allow_ordering_by: ["arch_context", "cm_type", "type", "date", "storage"]
    order: [arch_context, cm_type, type, date, storage, files]
  ui_elements:
    "files":
      element_type:
        name: "textfield"
        text: "files"
        value: "#(collected_material/uid)"
        lookup:
          lookup_type: "aggregate"
          record_type: "collected_material_photo"
          key_field: "uid_cm"
          aggregation_field: "uid_photo"
          aggregation_method: "count"
          default_to: "0"
