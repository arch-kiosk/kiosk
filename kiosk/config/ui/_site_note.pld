config:
  format_version: 1
compilations:
  site_note_compilation:
    name: site note view
    record_type: site_notes
    groups:
      group_1:
        type: "stacked"
        parts:
          site_note.sheet:
            text: '#(site/arch_context)'
            position: 1
#          site_notes.list:
#            text: '#(site/arch_context) notes'
#            position: 2
#          site_unit.list:
#            text: '#(/$/constants/labels/label_for_unit_on_start_page) list'
#            position: 3

          site_note_photos.list:
            text: '#(site/arch_context) note photos'
            position: 2

site_note.sheet:
  record_type: site_notes
  view_type: sheet
  fields_selection: dsd
  layout_settings:
    default_element_visibility: "."
    orchestration_strategy: columns
    order:
      - modified_by
      - modified
      - line_1
      - note
  ui_elements:
    line_1:
      layout:
        min_width: "max"
      element_type:
        visible: true
        name: "line"
        transparent: true


site_note_photos.list:
  record_type: site_note_photo
  view_type: list
  fields_selection: dsd
  layout_settings:
    type: list
    orchestration_strategy: gallery
    order_records_by: [ ">modified" ]
    allow_ordering_by: [ "modified", "modified_by" ]
    order: [ uid_image, modified, modified_by ]
  ui_elements:
    note:
      layout:
        min_width: 70%
    uid_image:
      element_type:
        name: "File"
