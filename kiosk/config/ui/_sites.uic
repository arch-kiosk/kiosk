# header
version: 1

# dsd('site','arch_context') && query-ui
element_type:
  name: "selection"
  links_to: site
  items:
    lookup_type: "table"
    topic: "site"
    selection: ["arch_context"]
    key: "arch_context"

# dsd('site','id') && query-ui
element_type:
  name: "selection"
  links_to: site
  items:
    lookup_type: "table"
    topic: "site"
    selection: ["id"]
    key: "id"

# dsd('site','purpose') && view-ui
layout:
  min_width: max
element_type:
  multiline: true

# dsd('site','uid_site_map') && view-ui
layout:
  min_width: max
  min_height: max
element_type:
  name: "File"
  file_description: bottom
  resolution: medium
  fit_content: contain

# dsd('site_notes','note') && view-ui && view_type:list
element_type:
  multiline: true
#  max_characters: 80

# dsd('site_notes','note') && view-ui && view_type:sheet
layout:
  min_width: max
  min_height: max
element_type:
  multiline: true

# dsd('site_notes','uid') && view-ui && view_type:list
layout:
  max_width: 1
element_type:
  visible: true
  is_identifier: true
  mask_identifier: "click to view"
  link_to: "site_notes"
  text: 'reference'
